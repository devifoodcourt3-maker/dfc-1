# Backend API base URL (same one the dashboard uses)
BACKEND_URL=https://dfc-backend.onrender.com
# Optional — only set if the realtime socket endpoint differs from BACKEND_URL
SOCKET_URL=

# Dashboard > Settings > Print Agent — get these two from there
RESTAURANT_ID=paste_restaurant_id_here
PRINT_AGENT_KEY=paste_print_agent_key_here

# Printed as the header line on every KOT
RESTAURANT_NAME=DFC Restaurant
TIMEZONE=Asia/Kolkata

# Printer connection target.
# USB printer with its Windows driver already installed (e.g. TH 400 Lite) — use
# the exact name from Windows Settings > Printers & Scanners, for example:
#   PRINTER_INTERFACE=TH 400 Lite
# Network printer instead: PRINTER_INTERFACE=tcp://192.168.1.87
PRINTER_INTERFACE=
# ESC/POS is the command set almost all thermal receipt printers use, TH 400 Lite included.
PRINTER_TYPE=EPSON
# 42 = 80mm paper (standard for restaurant receipt printers). Use ~32 for 58mm paper.
PRINTER_CHAR_WIDTH=42

# Retry behaviour for a single KOT print job before it's reported as failed
PRINT_RETRY_ATTEMPTS=3
PRINT_RETRY_DELAYS_MS=1000,3000,5000

# Safety-net poll for jobs missed while the agent was offline (ms)
POLL_INTERVAL_MS=60000
