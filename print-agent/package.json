{
  "name": "dfc-print-agent",
  "version": "1.0.0",
  "description": "Local bridge for DFC Restaurant: listens for confirmed orders and prints the kitchen order ticket (KOT) on the thermal printer",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "service:install": "node service/install.js",
    "service:uninstall": "node service/uninstall.js"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "dotenv": "^16.3.1",
    "node-thermal-printer": "^4.4.4",
    "node-windows": "^1.0.0-beta.8",
    "socket.io-client": "^4.6.2"
  }
}
